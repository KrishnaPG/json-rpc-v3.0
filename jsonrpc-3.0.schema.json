{
  "$schema": "https://json-schema.org/draft/2020-12/schema ",
  "$id": "https://cenacle-research.com/schemas/jsonrpc-3.0.schema.json",
  "title": "JSON-RPC 3.0 Message Schema",
  "description": "Schema to validate JSON-RPC 3.0 request and response messages, including streaming and enhanced error handling.",
  "type": "object",
  "oneOf": [{ "$ref": "#/definitions/JsonRpcRequest" }, { "$ref": "#/definitions/JsonRpcResponse" }],
  "definitions": {
    "JsonRpcVersion": {
      "type": "string",
      "enum": ["2.0", "3.0"]
    },
    "ErrorCode": {
      "type": "integer"
    },
    "ErrorContext": {
      "type": "object",
      "properties": {
        "code": { "$ref": "#/definitions/ErrorCode" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "data": {}
      },
      "required": ["code", "title"]
    },
    "ErrorContextAbort": {
      "allOf": [{ "$ref": "#/definitions/ErrorContext" }, { "properties": { "code": { "const": 8000 } } }]
    },
    "JsonRpcId": {
      "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "null" }]
    },
    "BaseJsonRpcVAny": {
      "type": "object",
      "properties": {
        "jsonrpc": { "$ref": "#/definitions/JsonRpcVersion" }
      },
      "required": ["jsonrpc"]
    },
    "BaseJsonRpcV2": {
      "allOf": [{ "$ref": "#/definitions/BaseJsonRpcVAny" }, { "properties": { "jsonrpc": { "const": "2.0" } } }]
    },
    "BaseJsonRpcV3": {
      "allOf": [{ "$ref": "#/definitions/BaseJsonRpcVAny" }, { "properties": { "jsonrpc": { "const": "3.0" } } }]
    },
    "BaseJsonRpcRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": { "$ref": "#/definitions/JsonRpcVersion" },
        "id": { "$ref": "#/definitions/JsonRpcId" },
        "method": { "type": "string" },
        "params": {}
      },
      "required": ["jsonrpc", "method"]
    },
    "TOptionsStream": {
      "type": "object",
      "properties": {
        "stream": { "oneOf": [{ "type": "boolean" }, { "$ref": "#/definitions/JsonRpcId" }] },
        "abort": { "type": "boolean" }
      }
    },
    "JsonRpcRequestV3": {
      "allOf": [
        { "$ref": "#/definitions/BaseJsonRpcRequest" },
        { "$ref": "#/definitions/BaseJsonRpcV3" },
        {
          "type": "object",
          "properties": {
            "options": { "$ref": "#/definitions/TOptionsStream" }
          }
        }
      ]
    },
    "JsonRpcStreamRequest": {
      "allOf": [
        { "$ref": "#/definitions/JsonRpcRequestV3" },
        {
          "type": "object",
          "properties": {
            "options": {
              "type": "object",
              "properties": {
                "stream": { "type": "boolean", "const": true }
              },
              "required": ["stream"]
            }
          },
          "required": ["options"]
        }
      ]
    },
    "JsonRpcStreamRequestAbort": {
      "allOf": [
        { "$ref": "#/definitions/BaseJsonRpcV3" },
        {
          "type": "object",
          "properties": {
            "id": { "type": "null" },
            "options": {
              "type": "object",
              "properties": {
                "stream": { "$ref": "#/definitions/JsonRpcId" },
                "abort": { "type": "boolean", "const": true }
              },
              "required": ["stream", "abort"]
            }
          },
          "required": ["options"],
          "not": { "required": ["id"] }
        }
      ]
    },
    "JsonRpcSuccessResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": { "$ref": "#/definitions/JsonRpcVersion" },
        "id": { "$ref": "#/definitions/JsonRpcId" },
        "result": {}
      },
      "required": ["jsonrpc", "result"],
      "if": {
        "properties": { "error": {} }
      },
      "then": {
        "not": { "required": ["error"] }
      }
    },
    "JsonRpcErrorResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "3.0" },
        "id": { "$ref": "#/definitions/JsonRpcId" },
        "error": { "$ref": "#/definitions/ErrorContext" }
      },
      "required": ["jsonrpc", "error"],
      "if": {
        "properties": { "result": {} }
      },
      "then": {
        "not": { "required": ["result"] }
      }
    },
    "JsonRpcAck": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "3.0" },
        "id": { "$ref": "#/definitions/JsonRpcId" },
        "ack": {}
      },
      "required": ["jsonrpc", "ack"],
      "if": {
        "properties": { "result": {} }
      },
      "then": {
        "not": { "required": ["result"] }
      },
      "else": {},
      "if": {
        "properties": { "error": {} }
      },
      "then": {
        "not": { "required": ["error"] }
      },
      "else": {}
    },
    "JsonRpcStreamData": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "3.0" },
        "stream": {
          "type": "object",
          "properties": {
            "id": { "$ref": "#/definitions/JsonRpcId" },
            "data": {}
          },
          "required": ["id"]
        }
      },
      "required": ["jsonrpc", "stream"],
      "if": {
        "properties": { "id": {} }
      },
      "then": {
        "not": { "required": ["id"] }
      },
      "if": {
        "properties": { "result": {} }
      },
      "then": {
        "not": { "required": ["result"] }
      },
      "if": {
        "properties": { "error": {} }
      },
      "then": {
        "not": { "required": ["error"] }
      }
    },
    "JsonRpcStreamDone": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "3.0" },
        "stream": {
          "type": "object",
          "properties": {
            "id": { "$ref": "#/definitions/JsonRpcId" }
          },
          "required": ["id"]
        },
        "result": {}
      },
      "required": ["jsonrpc", "stream", "result"],
      "if": {
        "properties": { "stream": { "properties": { "data": {} } } }
      },
      "then": {
        "not": {
          "required": ["data"]
        }
      },
      "if": {
        "properties": { "error": {} }
      },
      "then": {
        "not": { "required": ["error"] }
      },
      "if": {
        "properties": { "id": {} }
      },
      "then": {
        "not": { "required": ["id"] }
      }
    },
    "JsonRpcStreamError": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "3.0" },
        "stream": {
          "type": "object",
          "properties": {
            "id": { "$ref": "#/definitions/JsonRpcId" }
          },
          "required": ["id"]
        },
        "error": { "$ref": "#/definitions/ErrorContext" }
      },
      "required": ["jsonrpc", "stream", "error"],
      "if": {
        "properties": { "stream": { "properties": { "data": {} } } }
      },
      "then": {
        "not": {
          "required": ["data"]
        }
      },
      "if": {
        "properties": { "result": {} }
      },
      "then": {
        "not": { "required": ["result"] }
      },
      "if": {
        "properties": { "id": {} }
      },
      "then": {
        "not": { "required": ["id"] }
      }
    },
    "JsonRpcStreamAborted": {
      "allOf": [
        { "$ref": "#/definitions/JsonRpcStreamError" },
        { "properties": { "error": { "$ref": "#/definitions/ErrorContextAbort" } } }
      ]
    },
    "JsonRpcRequest": {
      "oneOf": [
        { "$ref": "#/definitions/BaseJsonRpcRequest" },
        { "$ref": "#/definitions/JsonRpcRequestV3" },
        { "$ref": "#/definitions/JsonRpcStreamRequest" },
        { "$ref": "#/definitions/JsonRpcStreamRequestAbort" }
      ]
    },
    "JsonRpcMethodResponse": {
      "oneOf": [{ "$ref": "#/definitions/JsonRpcSuccessResponse" }, { "$ref": "#/definitions/JsonRpcErrorResponse" }]
    },
    "JsonRpcStreamResponse": {
      "oneOf": [
        { "$ref": "#/definitions/JsonRpcStreamData" },
        { "$ref": "#/definitions/JsonRpcStreamDone" },
        { "$ref": "#/definitions/JsonRpcStreamError" }
      ]
    },
    "JsonRpcResponse": {
      "oneOf": [
        { "$ref": "#/definitions/JsonRpcAck" },
        { "$ref": "#/definitions/JsonRpcStreamResponse" },
        { "$ref": "#/definitions/JsonRpcMethodResponse" }
      ]
    },
    "JsonRpcMessage": {
      "oneOf": [{ "$ref": "#/definitions/JsonRpcRequest" }, { "$ref": "#/definitions/JsonRpcResponse" }]
    }
  }
}
